{
  "name": "quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e.mjs",
    "test:contract": "node --test 'packages/quest-tools/test/*.test.ts'",
    "dev:store": "npm run dev -w worker",
    "dev:survey": "npm run dev -w survey",
    "build:survey": "npm run build -w survey"
  },
  "dependencies": {
    "opening_hours": "^3.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "@gatherlight/quest-tools": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "workspaces": [
    "packages/*",
    "worker",
    "survey"
  ]
}
